APP_NAME=UFDR Analysis Platform API
ENV=development
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
DATABASE_URL=sqlite:///./ufdr.db
LOG_LEVEL=INFO

# External LLM API Key (Groq Hosted API - https://console.groq.com)
# Default fast LLM provider for grounded Q&A inference.
# Provider-agnostic OpenAI-compatible API client.
EXTERNAL_LLM_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
