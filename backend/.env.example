APP_NAME=UFDR Analysis Platform API
ENV=development
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# PostgreSQL Database (Default for Production / Docker Compose)
DATABASE_URL=postgresql://ufdr_user:ufdr_pass@localhost:5432/ufdr_db

# SQLite Database (Fallback Option)
# DATABASE_URL=sqlite:///./ufdr.db

POSTGRES_DB=ufdr_db
POSTGRES_USER=ufdr_user
POSTGRES_PASSWORD=ufdr_pass

LOG_LEVEL=INFO

# Groq Hosted API Configuration
EXTERNAL_LLM_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
